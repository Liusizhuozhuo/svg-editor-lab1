@startuml
 title Stage 8 - Commands, mementos and document IO
 interface CommandContext {
   + getDocument(): SvgDocument
 }
 interface Command {
   + execute(context): CommandResult
 }
 interface UndoableCommand {
   + undo(context): CommandResult
   + redo(context): CommandResult
 }
 abstract class EditCommand {
   - phase
   - document
   # apply(document)
   # revert(document)
   # reapply(document)
 }
 class CreateCommand
 class MoveCommand
 class CommandResult
 class EditorSession
 class CommandExecutor
 class CommandHistory
 class SvgDocument
 class GeometrySnapshot
 abstract class Shape {
   + captureGeometry(): GeometrySnapshot
 }
 Command <|-- UndoableCommand
 UndoableCommand <|.. EditCommand
 EditCommand <|-- CreateCommand
 EditCommand <|-- MoveCommand
 CommandContext <|.. EditorSession
 CommandExecutor *-- EditorSession
 CommandExecutor *-- CommandHistory
 CommandHistory o-- UndoableCommand : undo / redo stacks
 CommandHistory ..> CommandContext
 EditCommand ..> CommandContext
 EditCommand ..> CommandResult
 CommandContext ..> SvgDocument
 CreateCommand ..> SvgDocument
 MoveCommand ..> Shape
 MoveCommand o-- GeometrySnapshot : before / after
 Shape ..> GeometrySnapshot : captures private geometry
 note bottom of CommandHistory
   Only successful operations move stack entries.
   Successful document operation clears and blocks history.
 end note
 abstract class StructuralEditCommand
 class DeleteCommand
 class GroupCommand
 class UngroupCommand
 class AddToCommand
 class FrontCommand
 class BackCommand
 class ScaleCommand
 class SetCommand
 class AttributeSnapshot
 class DocumentStructureSnapshot
 EditCommand <|-- StructuralEditCommand
 StructuralEditCommand <|-- DeleteCommand
 StructuralEditCommand <|-- GroupCommand
 StructuralEditCommand <|-- UngroupCommand
 StructuralEditCommand <|-- AddToCommand
 StructuralEditCommand <|-- FrontCommand
 StructuralEditCommand <|-- BackCommand
 EditCommand <|-- ScaleCommand
 EditCommand <|-- SetCommand
 ScaleCommand o-- GeometrySnapshot
 SetCommand o-- AttributeSnapshot
 StructuralEditCommand o-- DocumentStructureSnapshot
 SvgDocument ..> DocumentStructureSnapshot
 interface DocumentRepository
 class DocumentReadResult
 class SvgFileRepository
 class SvgReader
 class SvgWriter
 CommandExecutor o-- DocumentRepository
 DocumentRepository <|.. SvgFileRepository
 SvgFileRepository --> SvgReader
 SvgFileRepository --> SvgWriter
 SvgReader --> DocumentReadResult
@enduml
