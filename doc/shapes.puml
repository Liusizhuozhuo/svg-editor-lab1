@startuml
 title Stage 8 - Shapes and document structure
 abstract class Shape {
   - id: string
   + getId(): string
   + getType(): string
   + getAttributes(): readonly attributes
   + setAttribute(name, value): void
   + getChildren(): readonly Shape[]
   + move(dx, dy): void
   + scale(factor): void
   + accept(visitor)
   + captureGeometry()
   + captureAttributes()
   # planMove(dx, dy): update
   # planScale(factor): update
 }
 class Rect
 class Circle
 class Ellipse
 class Line
 class TextShape
 class Group {
   + constructor(id, children)
 }
 class SvgDocument {
   + insert(shape, parentId, position)
   + remove(id): Shape
   + reparent(id, parentId, position)
   + findById(id): Shape
   + group(newId, ids): Group
   + ungroup(id)
   + captureStructure()
   + resize(width, height)
 }
 class TreeStructure <<internal>>
 SvgDocument ..> TreeStructure
 Shape ..> TreeStructure
 Group ..> TreeStructure
 SvgDocument "0..1" o-- "0..*" Shape : roots and ID index
 class NumericRules
 class DomainError
 Shape <|-- Rect
 Shape <|-- Circle
 Shape <|-- Ellipse
 Shape <|-- Line
 Shape <|-- TextShape
 Shape <|-- Group
 Group "0..1" *-- "0..*" Shape : ordered children
 Shape ..> NumericRules
 NumericRules ..> DomainError
 note bottom of Group
   Structural changes go through SvgDocument.
   Plan all geometry updates before applying any.
   TreeStructure holds private parent/children/owner maps.
 end note
@enduml
